#!/usr/bin/env python3
"""Deterministic fake Claude Code CLI for offline harness tests.

Scenario via CLAUDE_FAKE_SCENARIO. With CLAUDE_FAKE_PATCH (a path) or
CLAUDE_FAKE_PATCH_TEXT (patch contents, for container runs) set, the "success"
scenario applies that patch in the working directory, standing in for edits.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys


def _emit(events: list[dict]) -> None:
    for event in events:
        sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


def _arg(args: list[str], flag: str, default: str | None = None) -> str | None:
    if flag in args:
        index = args.index(flag)
        if index + 1 < len(args):
            return args[index + 1]
    return default


def _init(model: str, api_key_source: str = "none") -> dict:
    return {
        "type": "system",
        "subtype": "init",
        "session_id": "sess_fake_1",
        "cwd": os.getcwd(),
        "model": model,
        "apiKeySource": api_key_source,
        "permissionMode": "dontAsk",
        "tools": ["Bash", "Read", "Edit", "Write", "Glob", "Grep"],
        "mcp_servers": [],
        "claude_code_version": os.environ.get("CLAUDE_FAKE_VERSION", "0.0.0-test"),
    }


def _assistant(model: str, text: str) -> dict:
    return {
        "type": "assistant",
        "session_id": "sess_fake_1",
        "message": {
            "model": model,
            "role": "assistant",
            "content": [
                {"type": "tool_use", "id": "toolu_1", "name": "Edit", "input": {}},
                {"type": "text", "text": text},
            ],
        },
    }


def _result(model: str, *, is_error: bool = False, subtype: str = "success", text: str = "done") -> dict:
    return {
        "type": "result",
        "subtype": subtype,
        "is_error": is_error,
        "result": text,
        "session_id": "sess_fake_1",
        "num_turns": 3,
        "duration_ms": 1200,
        "total_cost_usd": 0.0123,
        "usage": {"input_tokens": 100, "output_tokens": 40, "cache_read_input_tokens": 10},
        "modelUsage": {model: {"inputTokens": 100, "outputTokens": 40}},
        "permission_denials": [],
    }


def main() -> int:
    args = sys.argv[1:]
    if args[:1] in (["--version"], ["-v"]):
        print(os.environ.get("CLAUDE_FAKE_VERSION", "0.0.0-test") + " (Claude Code)")
        return 0
    if args[:2] == ["auth", "status"]:
        method = os.environ.get("CLAUDE_FAKE_AUTH", "claude.ai")
        logged_in = method != "none"
        print(json.dumps({"loggedIn": logged_in, "authMethod": method, "subscriptionType": "max"}))
        return 0 if logged_in else 1
    if "-p" not in args:
        print("fake claude: only -p is supported", file=sys.stderr)
        return 2
    model = _arg(args, "--model", "claude-opus-5-5") or "claude-opus-5-5"
    scenario = os.environ.get("CLAUDE_FAKE_SCENARIO", "success")

    if scenario == "crash":
        print("fatal: simulated crash", file=sys.stderr)
        return 1
    if scenario == "model_mismatch":
        _emit([_init("claude-sonnet-5-5"), _assistant("claude-sonnet-5-5", "done"), _result("claude-sonnet-5-5")])
        return 0
    if scenario == "fallback":
        _emit([_init(model), _assistant("claude-sonnet-5-5", "done"), _result("claude-sonnet-5-5")])
        return 0
    if scenario == "api_key":
        _emit([_init(model, api_key_source="ANTHROPIC_API_KEY"), _assistant(model, "done"), _result(model)])
        return 0
    if scenario == "usage_limit":
        _emit([_init(model), _result(model, is_error=True, subtype="error_during_execution",
                                    text="Claude usage limit reached. Your limit will reset at 5pm.")])
        return 1
    if scenario == "max_turns":
        _emit([_init(model), _assistant(model, "still working"), _result(model, subtype="error_max_turns", is_error=True)])
        return 1
    if scenario == "sleep":
        import time

        time.sleep(30)
        return 0

    patch = os.environ.get("CLAUDE_FAKE_PATCH")
    if patch:
        subprocess.run(["git", "apply", patch], check=True)
    patch_text = os.environ.get("CLAUDE_FAKE_PATCH_TEXT")
    if patch_text:
        subprocess.run(["git", "apply", "-"], input=patch_text, text=True, check=True)
    _emit([_init(model), _assistant(model, "done"), {"type": "future_event_type"}, _result(model)])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
